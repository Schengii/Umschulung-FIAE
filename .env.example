# ==============================================================================
# Environment Configuration (.env)
# ==============================================================================
# HINWEIS: Dies ist eine Vorlage für lokale Umgebungsvariablen.
# Echte API-Keys, Tokens und Geheimnisse NIEMALS in GitHub einchecken!
# .env ist in .gitignore und .claudeignore eingetragen.
# ==============================================================================

# Node-Umgebung
NODE_ENV=development
PORT=8080

# GitHub Integration & Automation (optional)
# Für lokale Sync-Skripte oder GitHub API Abfragen (z.B. scripts/sync_projects.js)
# GITHUB_TOKEN=ghp_your_personal_access_token_here
# GITHUB_OWNER=Schengii

# Vercel Deployment & CLI (optional)
# VERCEL_TOKEN=your_vercel_token_here
# VERCEL_ORG_ID=
# VERCEL_PROJECT_ID=

# E2E-Tests / Playwright Konfiguration
# PLAYWRIGHT_BASE_URL=http://localhost:8080
# E2E_ROOT=src
