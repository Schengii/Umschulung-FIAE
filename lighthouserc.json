{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/index.html",
        "http://localhost/pages/home.html",
        "http://localhost/pages/portfolio.html",
        "http://localhost/pages/ueber-mich.html",
        "http://localhost/pages/lebenslauf.html",
        "http://localhost/pages/dashboard.html",
        "http://localhost/pages/git-simulator.html",
        "http://localhost/pages/playground.html",
        "http://localhost/pages/architecture.html",
        "http://localhost/pages/flashcards.html",
        "http://localhost/pages/quiz.html",
        "http://localhost/pages/interview-trainer.html",
        "http://localhost/pages/ihk-cockpit.html",
        "http://localhost/pages/ausbildungsablauf.html",
        "http://localhost/pages/berufsfoerderungswerk.html",
        "http://localhost/pages/kostentraeger.html",
        "http://localhost/pages/praktikumsbetrieb.html",
        "http://localhost/pages/links.html",
        "http://localhost/pages/news.html"
      ],
      "numberOfRuns": 3
    },
    "assert": {
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.8, "aggregationMethod": "median-run" }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "cumulative-layout-shift": ["error", { "maxNumericValue": 0.1, "aggregationMethod": "median-run" }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
