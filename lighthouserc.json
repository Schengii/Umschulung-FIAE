{
  "ci": {
    "collect": {
      "staticDistDir": ".",
      "url": [
        "http://localhost/index.html",
        "http://localhost/pages/home.html",
        "http://localhost/pages/portfolio.html",
        "http://localhost/pages/ueber-mich.html",
        "http://localhost/pages/lebenslauf.html",
        "http://localhost/pages/dashboard.html",
        "http://localhost/pages/git-simulator.html",
        "http://localhost/pages/playground.html",
        "http://localhost/pages/architecture.html",
        "http://localhost/pages/flashcards.html",
        "http://localhost/pages/quiz.html",
        "http://localhost/pages/interview-trainer.html",
        "http://localhost/pages/ihk-cockpit.html"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.7 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
