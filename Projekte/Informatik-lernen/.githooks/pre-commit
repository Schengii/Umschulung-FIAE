#!/bin/sh
# ==============================================================================
# Git Pre-Commit Hook: Security- & Secret-Scanner
# ==============================================================================
# Verhindert versehentliches Committen von .env-Dateien, privaten Schlüsseln
# und sensiblen API-Keys / Tokens.
# ==============================================================================

# Farben für Terminal-Ausgabe (sofern unterstützt)
RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

ERRORS_FOUND=0

printf "${BLUE}[Pre-Commit Security Scan]${NC} Prüfe gestagte Dateien auf Geheimnisse...\n"

# ------------------------------------------------------------------------------
# 1. Prüfung auf geblockte Dateinamen (.env*, Schlüsseldateien etc.)
# ------------------------------------------------------------------------------
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

for FILE in $STAGED_FILES; do
    # Erlaube .env.example explizit
    if [ "$FILE" = ".env.example" ] || [ "$FILE" = ".env.template" ]; then
        continue
    fi

    # Blockiere .env und alle .env.* Varianten
    case "$FILE" in
        .env | .env.* | *.env | */.env | */.env.*)
            printf "${RED}[SICHERHEITS-FEHLER] Blockierte Umgebungsdatei im Commit entdeckt:${NC} %s\n" "$FILE"
            printf "${YELLOW}   -> .env-Dateien enthalten sensible Daten und dürfen nicht in Git gespeichert werden!${NC}\n"
            printf "${YELLOW}   -> Nutze 'git rm --cached %s' und trage Werte in .env.example als leere Vorlage ein.${NC}\n" "$FILE"
            ERRORS_FOUND=1
            ;;
        *.pem | *.key | *.pkcs12 | *.pfx | *id_rsa* | *id_ed25519*)
            printf "${RED}[SICHERHEITS-FEHLER] Privater Schlüssel / Zertifikat im Commit entdeckt:${NC} %s\n" "$FILE"
            printf "${YELLOW}   -> Nutze 'git rm --cached %s' um die Schlüsseldatei aus dem Index zu entfernen.${NC}\n" "$FILE"
            ERRORS_FOUND=1
            ;;
    esac
done

# ------------------------------------------------------------------------------
# 2. Inhaltsprüfung des gestagten Diffs auf API-Keys & Secrets
# ------------------------------------------------------------------------------
# Prüft nur neu hinzugefügte oder geänderte Zeilen (Zeilen beginnend mit '+')
STAGED_DIFF=$(git diff --cached -U0)

if [ -n "$STAGED_DIFF" ]; then
    # Filtert Metadaten-Zeilen wie '+++ b/pfad' heraus
    ADDED_LINES=$(printf "%s\n" "$STAGED_DIFF" | grep '^[+]' | grep -v '^[+][+][+]')

    # Reguläre Ausdrücke für bekannte Token- und Schlüssel-Formate (mit -e gegen Optionskonflikte)
    # 1. Anthropic API Keys (sk-ant-...)
    if printf "%s\n" "$ADDED_LINES" | grep -Eq -e 'sk-ant-[a-zA-Z0-9_\-]{20,}'; then
        printf "${RED}[SICHERHEITS-FEHLER] Anthropic Claude API-Key (sk-ant-...) im gestagten Code entdeckt!${NC}\n"
        ERRORS_FOUND=1
    fi

    # 2. OpenAI API Keys (sk-proj-... oder sk-...)
    if printf "%s\n" "$ADDED_LINES" | grep -v 'sk-ant-' | grep -Eq -e 'sk-(proj-)?[a-zA-Z0-9_\-]{30,}'; then
        printf "${RED}[SICHERHEITS-FEHLER] OpenAI API-Key im gestagten Code entdeckt!${NC}\n"
        ERRORS_FOUND=1
    fi

    # 3. GitHub Personal Access Tokens (ghp_..., github_pat_...)
    if printf "%s\n" "$ADDED_LINES" | grep -Eq -e '(ghp_[a-zA-Z0-9]{36}|github_pat_[a-zA-Z0-9_]{22,})'; then
        printf "${RED}[SICHERHEITS-FEHLER] GitHub Token (ghp_ / github_pat_) im gestagten Code entdeckt!${NC}\n"
        ERRORS_FOUND=1
    fi

    # 4. AWS Access Key IDs (AKIA...)
    if printf "%s\n" "$ADDED_LINES" | grep -Eq -e 'AKIA[0-9A-Z]{16}'; then
        printf "${RED}[SICHERHEITS-FEHLER] AWS Access Key ID (AKIA...) im gestagten Code entdeckt!${NC}\n"
        ERRORS_FOUND=1
    fi

    # 5. Private Key Blöcke
    if printf "%s\n" "$ADDED_LINES" | grep -Eq -e '-----BEGIN (RSA|EC|DSA|OPENSSH|PRIVATE) KEY-----'; then
        printf "${RED}[SICHERHEITS-FEHLER] Privater kryptografischer Schlüsselblock im gestagten Code entdeckt!${NC}\n"
        ERRORS_FOUND=1
    fi

    # 6. Slack / Stripe Live Tokens
    if printf "%s\n" "$ADDED_LINES" | grep -Eq -e '(xox[baprs]-[0-9a-zA-Z]{10,}|sk_live_[0-9a-zA-Z]{24})'; then
        printf "${RED}[SICHERHEITS-FEHLER] Sensibler Service-Token (Slack / Stripe) im gestagten Code entdeckt!${NC}\n"
        ERRORS_FOUND=1
    fi

    # 7. Generische Hardcoded API Key / Secret Zuweisungen mit echten Strings (> 20 Zeichen)
    # Ignoriert leere Variablen oder Standard-Testdummies
    if printf "%s\n" "$ADDED_LINES" | grep -Eiq -e '(api[_-]?key|secret[_-]?key|auth[_-]?token|access[_-]?token)\s*[:=]\s*["'\''][a-zA-Z0-9_\-]{20,}["'\'']'; then
        SUSPECT=$(printf "%s\n" "$ADDED_LINES" | grep -Eio -e '(api[_-]?key|secret[_-]?key|auth[_-]?token|access[_-]?token)\s*[:=]\s*["'\''][a-zA-Z0-9_\-]{20,}["'\'']')
        if ! printf "%s\n" "$SUSPECT" | grep -Eiq -e '(test|mock|dummy|example|placeholder|changeme)'; then
            printf "${RED}[SICHERHEITS-FEHLER] Verdächtige API-Key / Secret-Zuweisung entdeckt:${NC}\n   %s\n" "$SUSPECT"
            ERRORS_FOUND=1
        fi
    fi
fi

# ------------------------------------------------------------------------------
# 3. Auswertung
# ------------------------------------------------------------------------------
if [ "$ERRORS_FOUND" -ne 0 ]; then
    printf "\n${RED}❌ Commit abgebrochen!${NC} Behebe die oben genannten Sicherheitsprobleme vor dem Commit.\n"
    printf "   Tipp: Verwende Umgebungsvariablen (.env) oder die Systemumgebung statt Secrets im Code.\n"
    printf "   (Notfall-Bypass nur für vertrauenswürdige Ausnahmen: 'git commit --no-verify')\n\n"
    exit 1
fi

printf "${GREEN}✔ Pre-Commit Security Scan erfolgreich:${NC} Keine sensiblen Dateien oder Secrets gefunden.\n"
exit 0
