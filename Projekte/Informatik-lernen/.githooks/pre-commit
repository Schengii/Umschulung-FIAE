#!/bin/sh
# Git pre-commit hook to prevent committing secrets, sensitive keys, or .env files.
set -e

# 1. Bevorzuge gitleaks, falls installiert
if command -v gitleaks >/dev/null 2>&1; then
    printf "[pre-commit] Prüfe Staged Changes mit gitleaks...\n"
    if ! gitleaks protect --staged --verbose --redact; then
        printf "❌ [pre-commit] Commit abgebrochen: gitleaks hat vertrauliche Daten entdeckt!\n" >&2
        exit 1
    fi
    exit 0
fi

# 2. Shell-Fallback
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

ERRORS_FOUND=0

# Dateinamen und Inhalte prüfen
for FILE in $STAGED_FILES; do
    [ -z "$FILE" ] && continue

    # Eigene Hook-Definitionen nicht auf sich selbst matchen lassen
    case "$FILE" in
        .githooks/*)
            continue
            ;;
    esac

    FILENAME=$(basename "$FILE")

    # a) Dateinamen-Prüfung (.env, .env.* außer .env.example, *.pem, *.key)
    if [ "$FILENAME" != ".env.example" ]; then
        case "$FILENAME" in
            .env|.env.*|*.pem|*.key)
                printf "❌ [pre-commit] Blockiert: Datei '%s' hat sensiblen Dateinamen (Muster: .env, .env.*, *.pem, *.key)\n" "$FILE" >&2
                ERRORS_FOUND=1
                continue
                ;;
        esac
    fi

    # b) Inhaltsprüfung im gestagten Diff
    DIFF=$(git diff --cached -U0 -- "$FILE" | grep '^[+]' | grep -v '^[+][+][+]' || true)
    if [ -z "$DIFF" ]; then
        continue
    fi

    # Entferne das führende '+' der Diff-Zeilen, um den eigentlichen Code-Inhalt zu prüfen
    ADDED_CODE=$(printf "%s\n" "$DIFF" | sed 's/^+//')

    # sk-... (z. B. OpenAI, Anthropic)
    if printf "%s\n" "$ADDED_CODE" | grep -Eq -e 'sk-[a-zA-Z0-9_\-]{20,}'; then
        printf "❌ [pre-commit] Blockiert: Datei '%s' enthält sensibles Muster: 'sk-...'\n" "$FILE" >&2
        ERRORS_FOUND=1
    fi

    # AIza... (Google API Keys)
    if printf "%s\n" "$ADDED_CODE" | grep -Eq -e 'AIza[0-9A-Za-z_\-]{20,}'; then
        printf "❌ [pre-commit] Blockiert: Datei '%s' enthält sensibles Muster: 'AIza...'\n" "$FILE" >&2
        ERRORS_FOUND=1
    fi

    # ghp_... (GitHub Personal Access Tokens)
    if printf "%s\n" "$ADDED_CODE" | grep -Eq -e 'ghp_[a-zA-Z0-9]{36}'; then
        printf "❌ [pre-commit] Blockiert: Datei '%s' enthält sensibles Muster: 'ghp_...'\n" "$FILE" >&2
        ERRORS_FOUND=1
    fi

    # AKIA... (AWS Access Keys)
    if printf "%s\n" "$ADDED_CODE" | grep -Eq -e 'AKIA[0-9A-Z]{16}'; then
        printf "❌ [pre-commit] Blockiert: Datei '%s' enthält sensibles Muster: 'AKIA...'\n" "$FILE" >&2
        ERRORS_FOUND=1
    fi

    # -----BEGIN ... PRIVATE KEY-----
    if printf "%s\n" "$ADDED_CODE" | grep -Eq -e '-----BEGIN[ A-Z0-9_\-]*PRIVATE KEY-----'; then
        printf "❌ [pre-commit] Blockiert: Datei '%s' enthält sensibles Muster: '-----BEGIN ... PRIVATE KEY-----'\n" "$FILE" >&2
        ERRORS_FOUND=1
    fi

    # Zuweisungen wie API_KEY=, SECRET=, TOKEN= mit nichtleerem Wert
    if printf "%s\n" "$ADDED_CODE" | grep -Eiq -e '^[[:space:]]*(export[[:space:]]+)?(api_key|secret|token)[[:space:]]*=[[:space:]]*(["'\''"][^"'\'']{1,}["'\''"]|[^[:space:]"'\'']{1,})'; then
        printf "❌ [pre-commit] Blockiert: Datei '%s' enthält sensibles Muster: 'Zuweisung API_KEY=, SECRET= oder TOKEN='\n" "$FILE" >&2
        ERRORS_FOUND=1
    fi
done

if [ "$ERRORS_FOUND" -ne 0 ]; then
    printf "\n🚫 [pre-commit] Commit abgebrochen! Bitte vertrauliche Daten oder Schlüssel entfernen.\n" >&2
    exit 1
fi

printf "✔ [pre-commit] Security Scan erfolgreich: Keine sensiblen Dateien oder Secrets gefunden.\n"
exit 0
