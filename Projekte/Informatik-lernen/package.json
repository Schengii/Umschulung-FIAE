{
  "name": "informatiker-game",
  "private": true,
  "version": "3.79.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "oxlint src",
    "lint:ci": "oxlint src --deny-warnings",
    "preview": "vite preview",
    "test": "vitest run",
    "test:fast": "vitest run --exclude=\"**/*A11y*.test.jsx\" --exclude=\"**/*.routing.test.jsx\"",
    "test:coverage": "vitest run --coverage",
    "size": "size-limit",
    "e2e": "playwright test",
    "typecheck": "tsc --noEmit",
    "new-lab": "node scripts/new-lab.js",
    "docs:labs": "node scripts/gen-lab-list.js",
    "audit:ui": "node scripts/ui-audit.js",
    "gen:tailwind-light": "node scripts/gen-tailwind-light.js",
    "og:image": "node scripts/generate-og-image.js",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "size-limit": [
    {
      "name": "Vendor: React/Router/Zustand",
      "path": "dist/assets/vendor-react-*.js",
      "gzip": true,
      "limit": "70 KB"
    },
    {
      "name": "Vendor: UI (framer-motion, lucide, confetti)",
      "path": "dist/assets/vendor-ui-*.js",
      "gzip": true,
      "limit": "70 KB"
    },
    {
      "name": "Vendor: Charts (recharts)",
      "path": "dist/assets/vendor-charts-*.js",
      "gzip": true,
      "limit": "130 KB"
    },
    {
      "name": "Vendor: PDF (jspdf, html2canvas)",
      "path": "dist/assets/vendor-pdf-*.js",
      "gzip": true,
      "limit": "190 KB"
    },
    {
      "name": "Vendor: SQL (alasql)",
      "path": "dist/assets/vendor-sql-*.js",
      "gzip": true,
      "limit": "120 KB"
    },
    {
      "name": "Haupt-Bundle (App-Shell, ohne Labs)",
      "path": "dist/assets/index-*.js",
      "gzip": true,
      "limit": "105 KB"
    }
  ],
  "dependencies": {
    "@fontsource/atkinson-hyperlegible": "^5.2.0",
    "@fontsource/fira-code": "^5.2.0",
    "@fontsource/inter": "^5.2.0",
    "@fontsource/outfit": "^5.2.0",
    "@monaco-editor/react": "^4.7.0",
    "@sentry/react": "^11.8.0",
    "@vercel/analytics": "^2.0.1",
    "alasql": "^4.21.0",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^14.6.0",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.61.0",
    "monaco-editor": "0.57.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@size-limit/file": "^14.1.0",
    "@tailwindcss/vite": "^4.1.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "axe-core": "^4.14.0",
    "jsdom": "^30.1.3",
    "oxlint": "^1.88.0",
    "size-limit": "^14.1.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "dompurify": "^3.4.17",
    "braces": "^3.0.3",
    "image-size": "^2.0.3"
  }
}
