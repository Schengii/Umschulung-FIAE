[gd_scene format=3 uid="uid://lobby"]

[ext_resource type="Script" path="res://scripts/Lobby.gd" id="1_lobby"]

[node name="Lobby" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1_lobby")

[node name="VBox" type="VBoxContainer" parent="."]
layout_mode = 1
anchor_left = 0.3
anchor_top = 0.1
anchor_right = 0.7
anchor_bottom = 0.9
grow_horizontal = 2
grow_vertical = 2

[node name="TitleLabel" type="Label" parent="VBox"]
layout_mode = 2
text = "CoOp Versus Game"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 28

[node name="HostButton" type="Button" parent="VBox"]
layout_mode = 2
text = "🎮 Spiel hosten"
custom_minimum_size = Vector2(0, 48)

[node name="HSep1" type="HSeparator" parent="VBox"]
layout_mode = 2

[node name="ScanSection" type="VBoxContainer" parent="VBox"]
layout_mode = 2

[node name="ScanButton" type="Button" parent="VBox/ScanSection"]
layout_mode = 2
text = "🔍 LAN nach Hosts durchsuchen"
custom_minimum_size = Vector2(0, 42)

[node name="HostList" type="ItemList" parent="VBox/ScanSection"]
layout_mode = 2
