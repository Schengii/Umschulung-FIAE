[node name="HSep2" type="HSeparator" parent="VBox"]
layout_mode = 2

[node name="ManualSection" type="VBoxContainer" parent="VBox"]
layout_mode = 2
visible = false

[node name="ManualLabel" type="Label" parent="VBox/ManualSection"]
layout_mode = 2
