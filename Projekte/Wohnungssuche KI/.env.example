# ==============================================================================
# WOHNUNGSSUCHE KI - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Kopiere diese Datei nach .env und passe die Werte an deine Anforderungen an.
# SICHERHEITSHINWEIS: Trage niemals echte API-Keys in GitHub oder Commits ein!
# ==============================================================================

# ------------------------------------------------------------------------------
# App & Server Konfiguration
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Vercel Deployment
# ------------------------------------------------------------------------------
# In Vercel automatisch bereitgestellt, lokal optional
VERCEL_ENV=development

# ------------------------------------------------------------------------------
# KI-Modelle & API-Keys (Claude, Gemini, OpenAI)
# ------------------------------------------------------------------------------
# Anthropic Claude API (fuer Inserat-Analysen & Anschreiben-Erstellung)
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API (fuer Bilderkennung, Grundriss-Analysen & semantische Suche)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API (optional fuer Embeddings oder GPT-4)
OPENAI_API_KEY=your_openai_api_key_here

# ------------------------------------------------------------------------------
# Suchkriterien & Filter (Wohnungssuche Parameter)
# ------------------------------------------------------------------------------
SEARCH_CITY=Berlin
SEARCH_RADIUS_KM=15
MAX_WARMMIETE=1200
MIN_ROOMS=2
MIN_SIZE_SQM=50
PETS_ALLOWED=false
BALCONY_REQUIRED=false
KITCHEN_REQUIRED=true

# ------------------------------------------------------------------------------
# Automatisiertes Scraping & Abfrage-Intervalle
# ------------------------------------------------------------------------------
SCRAPER_INTERVAL_MINUTES=10
SCRAPER_USER_AGENT="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/128.0.0.0 Safari/537.36"
# Optional: Proxy zur Vermeidung von Rate-Limits & IP-Blocks
PROXY_URL=

# ------------------------------------------------------------------------------
# Benachrichtigungen (Sofort-Alarm bei neuen Treffern)
# ------------------------------------------------------------------------------
# Telegram Bot Benachrichtigungen
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Discord Webhook Benachrichtigungen
DISCORD_WEBHOOK_URL=

# E-Mail Benachrichtigungen (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
NOTIFICATION_EMAIL_TO=

# ------------------------------------------------------------------------------
# Datenbank & Caching (Vercel Postgres / KV / SQLite)
# ------------------------------------------------------------------------------
DATABASE_URL=postgresql://user:password@localhost:5432/wohnungssuche_ki
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ------------------------------------------------------------------------------
# Geo- & Arbeitsweg-Berechnung (Maps API)
# ------------------------------------------------------------------------------
GOOGLE_MAPS_API_KEY=
WORKPLACE_ADDRESS="Alexanderplatz 1, 10178 Berlin"
MAX_COMMUTE_MINUTES=40
