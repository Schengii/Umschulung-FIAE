# Auto detect text files and perform LF normalization
* text=auto eol=lf

# Code and configuration
*.js text eol=lf
*.cjs text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.css text eol=lf
*.scss text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.xml text eol=lf
*.gradle text eol=lf

# Windows scripts
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Binary assets - do not convert
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.ico binary
*.svg text eol=lf
*.pdf binary
*.ttf binary
*.woff binary
*.woff2 binary
*.eot binary
*.apk binary
*.aab binary
*.jar binary
*.dex binary
*.bin binary
*.sqlite binary
*.db binary
