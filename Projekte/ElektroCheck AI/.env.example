# ElektroCheck AI - Umgebungsvariablen-Vorlage (.env.example)
# Kopiere diese Datei nach '.env' und fülle die Werte für deine lokale Umgebung aus.
# Für das Vercel-Deployment: Trage diese Schlüssel in den Vercel Project Settings unter "Environment Variables" ein.

# ==============================================================================
# 1. KI-DIENSTE (Google Gemini & Perplexity)
# ==============================================================================
# Google Gemini API Key (Erforderlich für Diagnose, OCR, Schaltplan- & Wärmebildanalyse)
# Erstelle einen Key unter: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Tageskontingent KI-Analysen pro Nutzer (UTC-Tag; 0 = unbegrenzt, Standard: 300)
GEMINI_DAILY_LIMIT=300

# Primäres Gemini-Modell (Standard: gemini-2.0-flash)
GEMINI_MODEL=gemini-2.0-flash

# Fallback-Modell bei 404/503-Fehlern (Standard: gemini-1.5-flash; leer lassen für kein Fallback)
GEMINI_FALLBACK_MODEL=gemini-1.5-flash

# Perplexity API Key (Optional für Online-Normen- & Dokumentationsrecherche)
PERPLEXITY_API_KEY=

# ==============================================================================
# 2. SERVER & NETZWERK
# ==============================================================================
# Port für den lokalen Backend-Express-Adapter (Standard: 3000)
PORT=3000

# Erlaubte Frontend-Origins für CORS (kommagetrennt, Wildcard '*' möglich)
FRONTEND_URL=http://localhost:5173

# Reverse-Proxy Konfiguration (z. B. '1' für nginx/traefik/docker, damit Client-IPs korrekt ermittelt werden)
# TRUST_PROXY=1

# Log-Level für Backend-Pino (trace | debug | info | warn | error)
LOG_LEVEL=info

# ==============================================================================
# 3. AUTHENTIFIZIERUNG & SICHERHEIT
# ==============================================================================
# Wer sich anmelden darf: kommagetrennte E-Mails oder ganze Domains (z. B. "@firma.de")
# Wenn gesetzt, ist die Magic-Link-Login-Pflicht aktiv. In Production Pflicht, wenn kein APP_ACCESS_TOKEN existiert.
AUTH_ALLOWED_EMAILS=

# Admin-E-Mails mit vollen Rechten auf alle Prüf-Tickets (kommagetrennt)
AUTH_ADMIN_EMAILS=

# Basis-URL für den Magic-Link in der E-Mail (z. B. https://elektro-check-ai.vercel.app)
APP_URL=http://localhost:5173

# Dienst-Zugriffstoken für geschützte /api-Routen (Authorization: Bearer <Token>)
# In Production Pflicht, falls AUTH_ALLOWED_EMAILS nicht gesetzt ist.
# Erzeugen via: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_ACCESS_TOKEN=

# ==============================================================================
# 4. E-MAIL-VERSAND (Resend)
# ==============================================================================
# Resend API Key für PDF-Prüfbericht-Export und Magic-Link-Login
# In Production Pflicht (sonst 503). Lokal ohne Key wird der E-Mail-Versand simuliert.
RESEND_API_KEY=

# Absenderadresse (z. B. onboarding@resend.dev oder noreply@deine-domain.de)
EMAIL_FROM=onboarding@resend.dev

# ==============================================================================
# 5. DATENSPEICHERUNG & RATE-LIMITING (Upstash Redis)
# ==============================================================================
# Upstash Redis REST API (Dringend empfohlen für Vercel Serverless & Ticket-Persistenz)
# Erstelle eine kostenlose Redis-Datenbank unter: https://upstash.com
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Lokale Redis-Verbindung für den Express-Server (optional, z. B. redis://localhost:6379)
REDIS_URL=

# Pfad zur lokalen Ticket-Speicherdatei (Fallback, wenn kein Upstash konfiguriert ist)
TICKETS_FILE=backend/data/tickets.json

# ==============================================================================
# 6. REQUEST & PAYLOAD GRENZEN
# ==============================================================================
# Maximales Payload-Limit für Bildanalysen (Vercel Serverless Maximum: 4.5mb)
BODY_LIMIT_LARGE=4.5mb
