{
  "name": "electro-check-ai",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "start-backend": "node backend/index.js",
    "dev": "concurrently \"vite\" \"npm run start-backend\"",
    "build": "tsc && vite build",
    "lint": "eslint \"src/**/*.{ts,js}\" \"api/**/*.js\" \"backend/**/*.js\" --max-warnings=0",
    "check:secrets": "node scripts/check-secrets.mjs",
    "prepare": "husky install",
    "test": "npm run test:frontend && npm run test --prefix backend",
    "preview": "vite preview",
    "cap:sync": "cap sync",
    "cap:open": "cap open android",
    "test:frontend": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node e2e/smoke.mjs"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/geolocation": "^8.2.3",
    "@capacitor/network": "^8.0.1",
    "@google/genai": "^2.28.0",
    "@upstash/redis": "^1.39.0",
    "@vaadin/button": "^25.1.0",
    "@vaadin/progress-bar": "^25.1.0",
    "@vaadin/text-area": "^25.1.0",
    "@vaadin/text-field": "^25.1.0",
    "@vaadin/vaadin-lumo-styles": "^25.1.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "ajv": "^8.12.0",
    "html5-qrcode": "^2.3.8",
    "lit": "^3.3.2",
    "pdfmake": "^0.3.7"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^10.0.1",
    "@types/pdfmake": "^0.3.2",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^5.0.5",
    "concurrently": "^8.2.2",
    "eslint": "^10.5.0",
    "fake-indexeddb": "^6.2.5",
    "globals": "^17.13.0",
    "husky": "^8.0.0",
    "lint-staged": "^15.4.3",
    "picomatch": "^4.0.7",
    "playwright-core": "^1.64.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.4",
    "vite-plugin-pwa": "^0.21.2",
    "vitest": "^5.0.5"
  },
  "lint-staged": {
    "{src,api,backend}/**/*.{ts,js}": [
      "eslint --fix --max-warnings=0"
    ]
  },
  "overrides": {
    "lit": "$lit",
    "@lit/reactive-element": "^2.0.4",
    "lit-html": "^3.1.2",
    "lit-element": "^4.0.4",
    "braces": "^3.0.3",
    "micromatch": "^4.0.8",
    "tinypool": "^2.2.0",
    "yaml": "^2.9.1"
  }
}
