# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Quellcode & Konfigurationsdateien immer mit LF
*.ts text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.css text eol=lf
*.html text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.env* text eol=lf

# Windows-spezifische Skripte (Batch / PowerShell)
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binärdateien unverändert belassen
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.docx binary
*.apk binary
*.aab binary
*.jar binary
*.keystore binary
