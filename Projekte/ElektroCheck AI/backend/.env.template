# Beispiel .env.template für das Backend
# Kopiere diese Datei zu .env und fülle die Werte lokal aus. Niemals echte Keys ins Repository committen.

# Google Gemini API Key (Serverseitig!)
GEMINI_API_KEY=
# Tageskontingent KI-Analysen (Gemini) pro Nutzer und UTC-Tag; 0 = unbegrenzt (Standard: 300)
GEMINI_DAILY_LIMIT=

# Perplexity API Key (optional)
PERPLEXITY_API_KEY=

# Optional: Redis URL für persistentes Rate-Limiting (z.B. redis://user:pass@host:6379)
REDIS_URL=

# Server-Port (optional)
PORT=3000
# Hinter Reverse-Proxy/Docker: Anzahl vertrauter Proxys (z. B. 1), damit Rate-Limits die echte Client-IP nutzen. Leer = aus.
TRUST_PROXY=

# --- Login per Magic-Link ---
# Wer sich anmelden darf: kommagetrennte Adressen oder ganze Domains ("@firma.de"). Gesetzt = Login-Pflicht.
# In Production Pflicht (sonst 503). Ohne Mailversand (RESEND_API_KEY) gibt es lokal einen Direktlink.
AUTH_ALLOWED_EMAILS=
# Admins sehen alle Tickets (kommagetrennte Adressen)
AUTH_ADMIN_EMAILS=
# Basis-URL der App für den Link in der E-Mail, z.B. https://elektro-check-ai-three.vercel.app
APP_URL=
# Login/Sessions brauchen in Production Upstash Redis (UPSTASH_REDIS_REST_URL/TOKEN, siehe unten)

# Optionaler Dienst-Zugriffstoken für alle /api-Routen (Authorization: Bearer <Token>), z.B. für Skripte.
# Ohne AUTH_ALLOWED_EMAILS ersetzt er in Production den Login (sonst 503).
# Pflicht in Production (sonst 503). Erzeugen z.B. mit: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Im Frontend unter Einstellungen > Zugriffstoken eintragen.
APP_ACCESS_TOKEN=

# E-Mail-Versand über Resend (in Production Pflicht, sonst 503; lokal ohne Key Simulationsmodus)
RESEND_API_KEY=
# Absender. Ohne eigene verifizierte Domain: onboarding@resend.dev (Resend sendet dann nur an die Adresse des Resend-Kontos)
EMAIL_FROM=

# Erlaubte Frontend-Origins für CORS (kommagetrennt, "*" als Platzhalter, z.B. https://elektro-*.vercel.app).
# Capacitor-Apps (https://localhost, capacitor://localhost) sind immer erlaubt; APP_URL wird automatisch mitgenommen.
FRONTEND_URL=http://localhost:5173

# Gemini-Modell überschreiben (optional, Standard: gemini-2.0-flash)
GEMINI_MODEL=
# Ausweichmodell bei 404/503 des Hauptmodells (optional, Standard: gemini-1.5-flash; leer = kein Fallback)
# GEMINI_FALLBACK_MODEL=

# Ticket-Speicher: Upstash Redis (empfohlen, v.a. auf Vercel). Ohne diese Werte nutzt der lokale Server eine JSON-Datei,
# Vercel einen nicht persistenten In-Memory-Speicher.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Pfad der Ticket-Datei für lokale Läufe (optional)
TICKETS_FILE=

# Body-Limit des lokalen Express-Servers für Gemini-/E-Mail-Routen (Standard 4.5mb = harte Grenze von Vercel)
BODY_LIMIT_LARGE=
