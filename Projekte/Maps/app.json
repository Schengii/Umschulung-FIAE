{
  "expo": {
    "name": "Maps",
    "slug": "maps-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#121826"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.schengii.maps",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Maps benötigt Zugriff auf Ihren Standort, um Live-Navigation, Verkehrsmeldungen und Komoot-Wanderrouten anzuzeigen.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Maps nutzt Ihren Standort im Hintergrund für Abbiegehinweise und Stau-Warnungen.",
        "UIBackgroundModes": [
          "location",
          "fetch"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#121826"
      },
      "package": "com.schengii.maps",
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    }
  }
}
