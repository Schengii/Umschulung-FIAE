{
  "name": "maps-app",
  "version": "1.0.0",
  "description": "Cross-platform mobile navigation application combining Google Maps, Apple Maps & Komoot features for pedestrians, hikers, cyclists, and drivers with real-time traffic, media feeds, DSGVO & WCAG compliance.",
  "main": "node_modules/expo/AppEntry.js",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "build:android": "eas build --platform android",
    "build:ios": "eas build --platform ios",
    "build:all": "eas build --platform all",
    "submit:android": "eas submit --platform android",
    "submit:ios": "eas submit --platform ios"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-navigation/native": "^7.3.14",
    "@react-navigation/native-stack": "^7.18.6",
    "expo": "~51.0.0",
    "expo-document-picker": "^57.0.1",
    "expo-file-system": "^57.0.1",
    "expo-haptics": "~13.0.1",
    "expo-location": "~17.0.1",
    "expo-network": "^57.0.1",
    "expo-sensors": "~13.0.1",
    "expo-sharing": "^57.0.8",
    "expo-speech": "^57.0.1",
    "expo-sqlite": "^57.0.1",
    "expo-status-bar": "~1.12.1",
    "lucide-react-native": "^0.395.0",
    "react": "18.2.0",
    "react-native": "0.74.5",
    "react-native-maps": "1.14.0",
    "react-native-safe-area-context": "^5.8.0",
    "react-native-screens": "^4.26.2",
    "react-native-svg": "15.2.0"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.2.45",
    "babel-plugin-module-resolver": "^5.0.3",
    "jest": "^29.7.0",
    "jest-expo": "~51.0.0",
    "typescript": "^5.1.3"
  },
  "private": true
}
