#!/usr/bin/env bash
# ==============================================================================
# Git Pre-Commit Hook: Secret & .env Leak Prevention
# Blocks commits containing .env files (except .env.example) or hardcoded API keys
# ==============================================================================

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
BOLD='\033[1m'
NC='\033[0m' # No Color

FAILED=0

# ------------------------------------------------------------------------------
# 1. Block .env files from being staged / committed
# ------------------------------------------------------------------------------
ENV_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^\.env(\.|$)' | grep -v '^\.env\.example$')

if [ -n "$ENV_FILES" ]; then
    echo ""
    echo -e "${RED}${BOLD}[PRE-COMMIT ERROR] Blocked dangerous .env file from being committed:${NC}"
    for f in $ENV_FILES; do
        echo -e "  ${RED}✖ $f${NC}"
    done
    echo ""
    echo -e "${YELLOW}Only .env.example may be tracked in git.${NC}"
    echo -e "${CYAN}To unstage: git reset HEAD $ENV_FILES${NC}"
    echo ""
    FAILED=1
fi

# ------------------------------------------------------------------------------
# 2. Block common API keys and private keys in staged diffs
# ------------------------------------------------------------------------------
STAGED_DIFF=$(git diff --cached -U0 --diff-filter=ACM)

if [ -n "$STAGED_DIFF" ]; then
    PATTERNS=(
        "sk-ant-[a-zA-Z0-9_\-]{20,}:Anthropic API Key"
        "sk-proj-[a-zA-Z0-9_\-]{20,}:OpenAI Project API Key"
        "sk-[a-zA-Z0-9]{32,}:OpenAI Secret Key"
        "ghp_[a-zA-Z0-9]{36}:GitHub Personal Access Token"
        "github_pat_[a-zA-Z0-9_]{40,}:GitHub Fine-Grained Token"
        "AIza[0-9A-Za-z\-_]{35}:Google API Key"
        "AKIA[0-9A-Z]{16}:AWS Access Key ID"
        "xox[baprs]-[0-9a-zA-Z]{10,}:Slack Token"
        "-----BEGIN (RSA |EC |OPENSSH |PGP |DSA )?PRIVATE KEY-----:Private Encryption Key"
    )

    for item in "${PATTERNS[@]}"; do
        REGEX="${item%%:*}"
        DESC="${item##*:}"

        # Match only added lines (starting with + and not +++)
        MATCHES=$(echo "$STAGED_DIFF" | grep -E '^\+[^+]' | grep -E -e "$REGEX")

        if [ -n "$MATCHES" ]; then
            echo ""
            echo -e "${RED}${BOLD}[PRE-COMMIT ERROR] Potential Secret/API Key Detected ($DESC):${NC}"
            echo "$MATCHES" | head -n 5 | while read -r line; do
                echo -e "  ${RED}${line:1}${NC}"
            done
            echo ""
            echo -e "${YELLOW}Never commit live credentials or secret keys.${NC}"
            echo -e "${CYAN}Store keys in your local .env file (which is gitignored).${NC}"
            echo ""
            FAILED=1
        fi
    done
fi

if [ $FAILED -ne 0 ]; then
    echo -e "${RED}${BOLD}Commit aborted by pre-commit hook.${NC}"
    exit 1
fi

exit 0
