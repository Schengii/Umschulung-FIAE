# ==============================================================================
# Minecraft C++ Engine - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and adjust values for your local environment:
#   copy .env.example .env
# ==============================================================================

# Application Environment (development, testing, production)
APP_ENV=development

# Logging & Debugging (TRACE, DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO
OPENGL_DEBUG=1
ENABLE_PERF_METRICS=0

# Display & Window Settings
WINDOW_TITLE="Minecraft C++ Edition"
WINDOW_WIDTH=1280
WINDOW_HEIGHT=720
FULLSCREEN=0
VSYNC=1

# Graphics & Rendering Quality
VIEW_DISTANCE=12
FOV=75.0
SHADOWS_ENABLED=1
SHADOW_RESOLUTION=2048
BLOOM_ENABLED=1
SSAO_ENABLED=1
GOD_RAYS_ENABLED=1
DISTANCE_FOG_ENABLED=1

# World & Simulation Settings
DEFAULT_WORLD_NAME=World1
WORLD_SAVE_DIRECTORY=world_saves
DEFAULT_SEED=133742
SIMULATION_DISTANCE=8
THREAD_POOL_WORKERS=0 # 0 = auto-detect hardware concurrency

# Networking & Multiplayer (UDP / Winsock)
SERVER_HOST=127.0.0.1
SERVER_PORT=25565
MAX_PLAYERS=8
TICK_RATE=20

# Web Documentation & Showcase (Local Preview / Vercel)
WEB_DOCS_PORT=3000
WEB_DOCS_HOST=localhost

# Test & CI Settings
TEST_HEADLESS=1
TEST_CLEANUP_SAVES=1
