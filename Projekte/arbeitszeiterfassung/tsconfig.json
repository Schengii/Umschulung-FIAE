{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "js",
    "resolveJsonModule": true,
    "allowJs": true,
    "noEmit": false
  },
  "include": ["js/**/*.ts", "js/**/*.js"],
  "exclude": ["node_modules", "dist"]
}
