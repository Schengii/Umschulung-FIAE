#!/bin/sh
# ==============================================================================
# Git Pre-Commit Hook - FinanzPortfolio CoPilot
# ==============================================================================
# Verhindert versehentliche Commits von:
# 1. Lokalen .env-Dateien (.env, .env.local, .env.production etc. außer .env.example)
# 2. Hardcodierten API-Keys, Private Keys und Zugriffstoken
# ==============================================================================

RED='\033[0;31m'
YELLOW='\033[1;33m'
GREEN='\033[0;32m'
CYAN='\033[0;36m'
NC='\033[0m' # No Color

print_color() {
    printf "%b\n" "$1"
}

print_color "${CYAN}[Pre-Commit Check]${NC} Überprüfe gestagte Änderungen auf sensible Daten..."

EXIT_CODE=0

# ------------------------------------------------------------------------------
# 1. Prüfe auf gestagte .env Dateien
# ------------------------------------------------------------------------------
STAGED_ENV_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '^(\.env|\.env\..*)$' | grep -v '^\.env\.example$')

if [ -n "$STAGED_ENV_FILES" ]; then
    echo ""
    print_color "${RED}❌ COMMIT BLOCKIERT: Lokale .env-Datei erkannt!${NC}"
    print_color "${YELLOW}Folgende .env-Datei(en) wurden gestagt:${NC}"
    echo "$STAGED_ENV_FILES" | sed 's/^/  - /'
    echo ""
    echo "💡 Tipp: Echte Zugangsdaten gehören niemals ins Git Repository."
    echo "   Nutze '.env.example' für Dokumentationszwecke und entferne gestagte .env-Dateien mit:"
    echo "   git reset HEAD <datei>"
    echo ""
    EXIT_CODE=1
fi

# ------------------------------------------------------------------------------
# 2. Prüfe auf verdächtige API-Keys und Secrets im geänderten Code
# ------------------------------------------------------------------------------
# Hole nur die neu hinzugefügten Zeilen (beginnend mit + aber nicht +++)
STAGED_DIFF=$(git diff --cached -U0 --diff-filter=ACM | grep '^+' | grep -v '^+++')

if [ -n "$STAGED_DIFF" ]; then
    # Definiere RegEx-Muster für bekannte Secrets
    PATTERNS='(AKIA[0-9A-Z]{16}|ghp_[a-zA-Z0-9]{36}|github_pat_[a-zA-Z0-9_]{60,}|sk-[a-zA-Z0-9_\-]{24,}|sk-ant-[a-zA-Z0-9_\-]{20,}|-----BEGIN [A-Z ]*PRIVATE KEY-----)'

    FOUND_SECRETS=$(echo "$STAGED_DIFF" | grep -E "$PATTERNS")

    if [ -n "$FOUND_SECRETS" ]; then
        echo ""
        print_color "${RED}❌ COMMIT BLOCKIERT: Möglicher API-Key oder Private Key im Code gefunden!${NC}"
        print_color "${YELLOW}Verdächtige Zeilen in den gestagten Änderungen:${NC}"
        echo "$FOUND_SECRETS" | sed 's/^/  /'
        echo ""
        echo "💡 Tipp: Secrets sollten über Umgebungsvariablen (.env) bereitgestellt werden."
        echo ""
        EXIT_CODE=1
    fi

    # Zusätzliche Prüfung auf generische API-Key Zuweisungen mit echtem Wert
    GENERIC_KEY_PATTERN='(api[_-]?key|secret[_-]?key|auth[_-]?token|access[_-]?token)\s*[:=]\s*["'\''][a-zA-Z0-9_\-]{20,}["'\'']'
    FOUND_GENERIC=$(echo "$STAGED_DIFF" | grep -iE "$GENERIC_KEY_PATTERN" | grep -v -iE '(mock|demo|dummy|example|placeholder|process\.env|import\.meta\.env)')

    if [ -n "$FOUND_GENERIC" ]; then
        echo ""
        print_color "${RED}❌ COMMIT BLOCKIERT: Verdächtige Hardcoded-Token-Zuweisung erkannt!${NC}"
        print_color "${YELLOW}Verdächtige Zeilen:${NC}"
        echo "$FOUND_GENERIC" | sed 's/^/  /'
        echo ""
        EXIT_CODE=1
    fi
fi

if [ $EXIT_CODE -ne 0 ]; then
    print_color "${RED}Pre-Commit Check fehlgeschlagen.${NC} Der Commit wurde abgebrochen."
    exit 1
fi

print_color "${GREEN}✓ Pre-Commit Check erfolgreich:${NC} Keine Secrets oder .env-Dateien gefunden."
exit 0
