# ==============================================================================
# FinanzPortfolio CoPilot - Umgebungsvariablen-Vorlage (.env.example)
# ==============================================================================
# Kopiere diese Datei nach `.env` und passe die Werte bei Bedarf an:
#   cp .env.example .env
#
# HINWEIS: Alle Variablen, die im Client (Vite / Browser) verfügbar sein sollen,
# MÜSSEN mit `VITE_` beginnen! Trage hier NIEMALS private API-Keys mit Guthaben
# oder echte Passwörter ein, die ins Git gelangen könnten.
# ==============================================================================

# App-Metadaten
VITE_APP_TITLE="FinanzPortfolio CoPilot"
VITE_APP_VERSION="1.0.0"
VITE_DEFAULT_CURRENCY="EUR"

# Externe APIs (Optional)
# CoinGecko Demo/Pro API Key (optional, falls Standard Free-Tier Rate-Limits erreicht werden)
VITE_COINGECKO_API_KEY=""

# Backup & Synchronisation (Standard-Vorschlagswerte für Settings-Dialog)
# WebDAV / Nextcloud Server URL (z.B. https://cloud.example.com/remote.php/dav/files/user/)
VITE_DEFAULT_WEBDAV_URL=""
# Webhook Push URL für Automationen (z.B. n8n, Home Assistant)
VITE_DEFAULT_WEBHOOK_URL=""

# Entwicklungs-Flags
# Setze auf "true", um Mock-/Demo-Daten beim allerersten Start vorab anzubieten
VITE_ENABLE_MOCK_DATA="false"
