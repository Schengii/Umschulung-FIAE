# ==============================================================================
# .claudeignore - Verzeichnisse & Dateien, die Claude / Claude Code ignorieren soll
# ==============================================================================
# Hält das Kontextfenster von Claude sauber, schnell und fokussiert.

# Abhängigkeiten & Paketmanager
node_modules/
package-lock.json
yarn.lock
pnpm-lock.yaml

# Build-Artefakte & Output
dist/
dist-ssr/
build/
out/
.next/
.cache/
.temp/

# Backup-Dateien
*.bak
*.old

# Versionskontrolle
.git/
.svn/
.hg/

# Test-Reports & Coverage
coverage/
.nyc_output/
*.lcov

# Logs & temporäre Dateien
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Geheimnisse & lokale Umgebungen
.env
.env.*
!.env.example

# Editor- & OS-Dateien
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Große Binär- und Mediendateien
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.mp4
*.webm
*.mp3
*.wav
*.zip
*.tar.gz
*.wasm
