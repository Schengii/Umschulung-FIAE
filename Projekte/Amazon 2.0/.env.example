# ==============================================================================
# Amazon 2.0 - Umgebungsvariablen-Vorlage (.env.example)
# ==============================================================================
# Kopiere diese Datei nach `.env` für lokale Entwicklung:
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux / macOS:        cp .env.example .env
#
# WICHTIG: Alle Variablen, die im Vite-Client verfügbar sein sollen,
# MÜSSEN mit `VITE_` beginnen! Trage NIEMALS private API-Keys oder
# Produktions-Secrets in versionierte Dateien ein.
# ==============================================================================

# Basis-Konfiguration
VITE_APP_TITLE="Amazon 2.0 - Next-Gen E-Commerce"
VITE_APP_VERSION="3.8.0"
VITE_APP_ENV="development"

# Lokale & Externe API-Endpunkte
VITE_API_BASE_URL="http://localhost:3000/api"
VITE_ENABLE_MOCK_SERVICES="true"

# Lokalisierung & Währung
VITE_DEFAULT_LOCALE="de-DE"
VITE_DEFAULT_CURRENCY="EUR"

# Feature Flags & Simulationen
VITE_ENABLE_ANALYTICS="false"
VITE_ENABLE_DEBUG_LOGS="false"
VITE_QKD_SIMULATION_MODE="true"
VITE_LIGHTNING_NETWORK="testnet"

# Optionale Vercel / Cloud Bereitstellung
# (Werden bei Vercel automatisch oder im Vercel Dashboard bereitgestellt)
# VERCEL_ENV="development"
# VITE_VERCEL_ANALYTICS_ID=""
