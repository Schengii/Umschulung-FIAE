# Dependencies
node_modules/
**/node_modules/
**/.venv/
**/venv/
**/__pycache__/
*.pyc

# Build outputs & C++ / Android build artifacts
**/build/
**/*.pdb
**/*.ilk
**/*.exe
**/*.o
**/*.obj
**/*.bin
test-results/
playwright-report/
/dist/
# NOTE: Projekte/*/dist/ is intentionally NOT ignored — these are the live,
# committed build outputs served directly as demo links from the portfolio
# (see assets/js/projects_data.js). Only the Vite PWA dev-server artifact
# folder (never used in production) is excluded:
Projekte/**/dev-dist/
.lighthouseci/
.env
.env.*
!.env.example
.DS_Store
Thumbs.db

# Database & logs
**/*.db
**/*.log

# Private application documents (real personal PDFs, not meant for the public repo)
/Bewerbungsunterlagen/

# Visual Studio per-user state (Copilot snapshots/sessions) - never commit
.vs/

# Laufzeitdaten und Backups (koennen Zugangsdaten und persoenliche Daten enthalten)
*.sqlite
*.sqlite3
*.db
*.backup
*.bak

# Projektkopien (Archiv): Lockfiles gehören in die Original-Repos, nicht hierher
Projekte/**/package-lock.json
Projekte/**/.git/
Projekte/**/.idea/
Projekte/**/.gradle/
Projekte/**/.godot/
Projekte/**/platforms/
Projekte/**/plugins/
Projekte/**/capacitor-cordova-android-plugins/
Projekte/**/world_saves/
Projekte/**/.husky/
