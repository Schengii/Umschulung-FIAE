# Dependencies
node_modules/
**/node_modules/
**/.venv/
**/venv/
**/__pycache__/
*.pyc

# Build outputs & C++ / Android build artifacts
**/build/
**/*.pdb
**/*.ilk
**/*.exe
**/*.o
**/*.obj
**/*.bin
test-results/
playwright-report/
/dist/
# NOTE: Projekte/*/dist/ is intentionally NOT ignored — these are the live,
# committed build outputs served directly as demo links from the portfolio
# (see assets/js/projects_data.js). Only the Vite PWA dev-server artifact
# folder (never used in production) is excluded:
Projekte/**/dev-dist/
.lighthouseci/
.env
.env.*
.DS_Store
Thumbs.db

# Database & logs
**/*.db
**/*.log

# Private application documents (real personal PDFs, not meant for the public repo)
/Bewerbungsunterlagen/

# Visual Studio per-user state (Copilot snapshots/sessions) - never commit
.vs/
