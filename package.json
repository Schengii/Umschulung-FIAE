{
  "name": "umschulung-fiae",
  "version": "1.5.0",
  "description": "Portfolio Maximilian Schenk",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "http-server . -p 8080 -c-1",
    "build:dist": "node scripts/build_minified.js",
    "test": "playwright test",
    "test:unit": "vitest run",
    "test:coverage": "vitest run --coverage",
    "generate-data": "node scripts/generate_projects_data.js",
    "check-sync": "node scripts/check_data_sync.js",
    "check-head": "node scripts/check_head_consistency.js",
    "check-csp": "node scripts/verify_csp_hashes.js",
    "check-csp:fix": "node scripts/verify_csp_hashes.js --fix",
    "generate-sw-assets": "node scripts/generate_sw_assets.js",
    "check-lighthouse-urls": "node scripts/check_lighthouse_urls.js",
    "check-sw-assets": "node scripts/generate_sw_assets.js --check",
    "sync-projects": "node scripts/sync_projects.js",
    "lint": "eslint assets/js scripts sw.js",
    "lint:fix": "eslint assets/js scripts sw.js --fix",
    "format:check": "prettier --check \"assets/js/**/*.js\" \"scripts/**/*.js\" sw.js",
    "format:fix": "prettier --write \"assets/js/**/*.js\" \"scripts/**/*.js\" sw.js",
    "typecheck": "tsc --noEmit -p jsconfig.json && tsc --noEmit -p jsconfig.sw.json",
    "check-strict-null": "node scripts/check_strict_null.js",
    "optimize-images": "node scripts/optimize_images.js",
    "compress-images": "node scripts/optimize_images.js --compress",
    "audit-project-paths": "node scripts/audit_project_html_paths.js",
    "check-project-links": "node scripts/check_all_project_links.js",
    "generate-og-image": "node scripts/generate_og_image.js",
    "generate-qr-codes": "node scripts/generate_qr_codes.js",
    "subset-icons": "node scripts/subset_fontawesome.js",
    "check-icons": "node scripts/subset_fontawesome.js --check",
    "update-sitemap": "node scripts/update_sitemap.js",
    "check-sitemap": "node scripts/update_sitemap.js --check",
    "check-bilingual": "node scripts/check_bilingual.js",
    "build-search-index": "node scripts/build_search_index.js",
    "check-search-index": "node scripts/build_search_index.js --check",
    "generate-site-stats": "node scripts/generate_site_stats.js",
    "generate-cv-pdf": "node scripts/generate_cv_pdf.js",
    "sync-structured-data": "node scripts/sync_structured_data.js",
    "check-structured-data": "node scripts/sync_structured_data.js --check",
    "check-site-stats": "node scripts/generate_site_stats.js --check",
    "import-flashcards": "node scripts/import_vault_flashcards.js",
    "check-flashcards": "node scripts/import_vault_flashcards.js --check",
    "check-exam-questions": "node scripts/check_exam_questions.js",
    "regen": "npm run subset-icons && npm run build-search-index && npm run generate-sw-assets",
    "check": "npm run check-sync && npm run check-head && npm run check-csp && npm run check-icons && npm run check-sitemap && npm run check-bilingual && npm run check-search-index && npm run check-site-stats && npm run check-structured-data && npm run check-flashcards && npm run check-exam-questions && npm run check-lighthouse-urls && npm run check-sw-assets && npm run check-project-links && npm run lint && npm run format:check && npm run typecheck && npm run check-strict-null && npm run test:unit"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@fortawesome/fontawesome-free": "7.3.1",
    "@playwright/test": "1.63.0",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.3",
    "http-server": "^14.1.1",
    "prettier": "^3.10.1",
    "sharp": "^0.35.4",
    "subset-font": "^2.9.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
