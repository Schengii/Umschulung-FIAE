#!/bin/sh
# ==============================================================================
# Git Pre-Commit Hook: Secret- & .env-Schutz
# ==============================================================================
# Verhindert das versehentliche Committen von:
# 1. Dateinamen: .env, .env.* (außer .env.example), *.pem, *.key
# 2. Inhalten mit API-Keys & Secrets (sk-..., AIza..., ghp_..., AKIA...,
#    "-----BEGIN ... PRIVATE KEY-----", Zuweisungen wie API_KEY=, SECRET=, TOKEN=)
# 
# Gibt bei Treffern ausschließlich Datei und Muster aus, nie den geheimen Wert!
# Bevorzugt gitleaks (falls installiert), sonst robuster Shell-Fallback.
# ==============================================================================

# Nur gestagte Dateien prüfen
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

EXIT_CODE=0

# ------------------------------------------------------------------------------
# 1. Dateinamen-Prüfung: .env, .env.* (außer .env.example), *.pem, *.key
# ------------------------------------------------------------------------------
BLOCKED_FILES=""

for file in $STAGED_FILES; do
    base=$(basename "$file")

    # a) .env und .env.* (außer .env.example)
    case "$base" in
        .env.example)
            ;;
        .env|.env.*)
            BLOCKED_FILES="${BLOCKED_FILES}  - Datei: $file (Muster: .env-Datei)
"
            ;;
    esac

    # b) *.pem und *.key
    case "$file" in
        *.pem)
            BLOCKED_FILES="${BLOCKED_FILES}  - Datei: $file (Muster: *.pem Zertifikatsdatei)
"
            ;;
        *.key)
            BLOCKED_FILES="${BLOCKED_FILES}  - Datei: $file (Muster: *.key Schlüsseldatei)
"
            ;;
    esac
done

if [ -n "$BLOCKED_FILES" ]; then
    echo "======================================================================"
    echo "❌ [PRE-COMMIT] Commit blockiert: Verbotene Dateinamen im Staging-Bereich!"
    echo "----------------------------------------------------------------------"
    printf "%s" "$BLOCKED_FILES"
    echo "----------------------------------------------------------------------"
    echo "Empfehlung: Verwende .env.example für Templates und halte Keys außerhalb von Git."
    echo "            Datei aus Staging entfernen: git reset HEAD <datei>"
    echo "======================================================================"
    EXIT_CODE=1
fi

# ------------------------------------------------------------------------------
# 2. Inhaltsprüfung: gitleaks bevorzugen, sonst Shell-Fallback
# ------------------------------------------------------------------------------
if command -v gitleaks >/dev/null 2>&1; then
    echo "🔍 [PRE-COMMIT] Führe Secret-Scan via gitleaks aus..."
    if ! gitleaks protect --staged --verbose --redact; then
        echo "======================================================================"
        echo "❌ [PRE-COMMIT] Commit blockiert: gitleaks hat Secrets im gestageten Diff gefunden!"
        echo "======================================================================"
        exit 1
    fi
    if [ "$EXIT_CODE" -ne 0 ]; then
        exit "$EXIT_CODE"
    fi
    exit 0
fi

# ------------------------------------------------------------------------------
# 3. Shell-Fallback für Inhaltsprüfung
# Geprüft werden nur neu hinzugefügte/geänderte Zeilen im gestageten Diff.
# Ausgabe ausschließlich Datei + Mustername, NIEMALS der geheime Wert!
# ------------------------------------------------------------------------------
FOUND_CONTENT_SECRETS=""

for file in $STAGED_FILES; do
    # Überspringe den Hook selbst und nicht mehr existierende Dateien
    case "$file" in
        .githooks/*)
            continue
            ;;
    esac

    if [ ! -f "$file" ]; then
        continue
    fi

    # Nur hinzugefügte Zeilen (+), aber keine Git-Diff-Header (+++)
    DIFF_CONTENT=$(git diff --cached -U0 -- "$file" 2>/dev/null | grep '^[+]' | grep -v '^[+][+][+]')

    if [ -z "$DIFF_CONTENT" ]; then
        continue
    fi

    FILE_PATTERNS=""

    # 1. sk-... (OpenAI / Anthropic Keys)
    if echo "$DIFF_CONTENT" | grep -qE '\bsk-[A-Za-z0-9_-]{16,}'; then
        FILE_PATTERNS="${FILE_PATTERNS}  - Muster: sk-... (API-Key / Token)
"
    fi

    # 2. AIza... (Google / Gemini API Keys)
    if echo "$DIFF_CONTENT" | grep -qE '\bAIza[0-9A-Za-z_-]{35}\b'; then
        FILE_PATTERNS="${FILE_PATTERNS}  - Muster: AIza... (Google/Gemini API-Key)
"
    fi

    # 3. ghp_... (GitHub Personal Access Tokens)
    if echo "$DIFF_CONTENT" | grep -qE '\bghp_[A-Za-z0-9_]{30,}'; then
        FILE_PATTERNS="${FILE_PATTERNS}  - Muster: ghp_... (GitHub Personal Access Token)
"
    fi

    # 4. AKIA... (AWS Access Keys)
    if echo "$DIFF_CONTENT" | grep -qE '\bAKIA[0-9A-Z]{16}\b'; then
        FILE_PATTERNS="${FILE_PATTERNS}  - Muster: AKIA... (AWS Access Key ID)
"
    fi

    # 5. -----BEGIN … PRIVATE KEY-----
    if echo "$DIFF_CONTENT" | grep -qE -- '-----BEGIN [A-Z0-9_-]+ PRIVATE KEY-----'; then
        MATCHED_KEY=$(echo "$DIFF_CONTENT" | grep -E -- '-----BEGIN [A-Z0-9_-]+ PRIVATE KEY-----' | grep -v 'SECRET SERVER PRIVATE KEY')
        if [ -n "$MATCHED_KEY" ]; then
            FILE_PATTERNS="${FILE_PATTERNS}  - Muster: -----BEGIN ... PRIVATE KEY----- (Privater kryptografischer Schlüssel)
"
        fi
    fi

    # 6. Zuweisungen wie API_KEY=, SECRET=, TOKEN= mit nichtleerem Wert
    # Schließt unkritische Platzhalter (your_..., placeholder, example, dummy, empty) aus
    ASSIGNMENT_MATCH=$(echo "$DIFF_CONTENT" | grep -iE '\b(API_KEY|SECRET|TOKEN)\s*[:=]\s*["\x27]?[^"'\''\s#]+' | grep -v -iE '(your_|_here|example|dummy|placeholder|mock|undefined|null|"")')
    if [ -n "$ASSIGNMENT_MATCH" ]; then
        FILE_PATTERNS="${FILE_PATTERNS}  - Muster: Zuweisung mit nichtleerem Wert (API_KEY= / SECRET= / TOKEN=)
"
    fi

    if [ -n "$FILE_PATTERNS" ]; then
        FOUND_CONTENT_SECRETS="${FOUND_CONTENT_SECRETS}Datei: $file
${FILE_PATTERNS}"
    fi
done

if [ -n "$FOUND_CONTENT_SECRETS" ]; then
    echo "======================================================================"
    echo "❌ [PRE-COMMIT] Commit blockiert: Potenziell vertrauliche Keys im Diff gefunden!"
    echo "Hinweis: Es werden ausschließlich betroffene Dateien und Muster ausgegeben."
    echo "----------------------------------------------------------------------"
    printf "%s" "$FOUND_CONTENT_SECRETS"
    echo "----------------------------------------------------------------------"
    echo "Empfehlung: Verwende Umgebungsvariablen und halte Secrets außerhalb des Repos."
    echo "======================================================================"
    EXIT_CODE=1
fi

exit "$EXIT_CODE"
